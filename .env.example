# ---- Video backend ----
# local = built-in browser-to-browser WebRTC (for testing, no Jitsi needed)
# jitsi = your self-hosted Jitsi server (settings below)
VIDEO_BACKEND=local
# STUN/TURN for local mode. STUN is enough on the same LAN.
LOCAL_ICE_SERVERS=stun:stun.l.google.com:19302

# ---- Jitsi (self-hosted) ----
# Public hostname of your Jitsi server (what the browser connects to)
JITSI_DOMAIN=meet.example.com
# XMPP domain and MUC domain.
#   Debian/Ubuntu package install: JITSI_XMPP_DOMAIN=meet.example.com, JITSI_MUC_DOMAIN=conference.meet.example.com
#   docker-jitsi-meet defaults:     JITSI_XMPP_DOMAIN=meet.jitsi,       JITSI_MUC_DOMAIN=muc.meet.jitsi
JITSI_XMPP_DOMAIN=meet.example.com
JITSI_MUC_DOMAIN=conference.meet.example.com

# JWT auth (Prosody token auth). Leave both empty if your server allows anonymous joins.
JITSI_APP_ID=remote_maint
JITSI_APP_SECRET=change-me-to-a-long-random-string

# ---- App ----
APP_SECRET=change-me-too
DATABASE_PATH=data/maintenance.db
CAMERAS_FILE=cameras.json

# ---- Object tracking ----
# csrt (accurate, default), kcf (faster), mil (fallback)
TRACKER_ALGO=csrt
# Annotation is marked "lost" after this many failed frames
TRACKER_LOST_FRAMES=15
